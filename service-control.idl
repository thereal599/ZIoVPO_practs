[
    uuid(D8F5A9F1-AFBA-4B25-A24F-E556B8372795),
    version(1.0)
]
interface ZiovpoServiceControl
{
    typedef enum _RpcStatusCode
    {
        RPC_APP_OK = 0,
        RPC_APP_NOT_AUTHENTICATED = 1,
        RPC_APP_BAD_CREDENTIALS = 2,
        RPC_APP_SESSION_EXPIRED = 3,
        RPC_APP_NO_LICENSE = 10,
        RPC_APP_LICENSE_BLOCKED = 11,
        RPC_APP_LICENSE_EXPIRED = 12,
        RPC_APP_INVALID_ACTIVATION_KEY = 13,
        RPC_APP_LICENSE_OWNED_BY_ANOTHER_USER = 14,
        RPC_APP_DEVICE_OWNED_BY_ANOTHER_USER = 15,
        RPC_APP_DEVICE_LIMIT_REACHED = 16,
        RPC_APP_AV_DATABASE_NOT_LOADED = 20,
        RPC_APP_SCAN_ERROR = 21,
        RPC_APP_SERVER_ERROR = 100,
        RPC_APP_NETWORK_ERROR = 101
    } RpcStatusCode;

    typedef struct _RpcUserInfo
    {
        int authenticated;
        [string] wchar_t* username;
        int statusCode;
        [string] wchar_t* message;
    } RpcUserInfo;

    typedef struct _RpcLicenseInfo
    {
        int hasLicense;
        int active;
        int blocked;
        [string] wchar_t* expirationDate;
        int statusCode;
        [string] wchar_t* message;
    } RpcLicenseInfo;

    typedef struct _RpcAvDatabaseInfo
    {
        int loaded;
        int recordCount;
        [string] wchar_t* releaseDate;
        int statusCode;
        [string] wchar_t* message;
    } RpcAvDatabaseInfo;

    typedef struct _RpcScanResult
    {
        int statusCode;
        int infected;
        int scannedFiles;
        int threatsFound;
        [string] wchar_t* objectPath;
        [string] wchar_t* threatName;
        [string] wchar_t* message;
    } RpcScanResult;

    typedef struct _RpcScheduledScanInfo
    {
        int enabled;
        int intervalMinutes;
        int scanFixedDrives;
        [string] wchar_t* path;
        [string] wchar_t* lastRunTime;
        int lastStatusCode;
        int lastScannedFiles;
        int lastThreatsFound;
        [string] wchar_t* lastMessage;
    } RpcScheduledScanInfo;

    typedef struct _RpcDirectoryMonitorInfo
    {
        int enabled;
        [string] wchar_t* path;
        [string] wchar_t* lastEventTime;
        int lastStatusCode;
        int lastScannedFiles;
        int lastThreatsFound;
        [string] wchar_t* lastMessage;
    } RpcDirectoryMonitorInfo;

    void StopService();
    void GetCurrentUser([out] RpcUserInfo* info);
    int Login([in, string] wchar_t* username, [in, string] wchar_t* password, [out, string] wchar_t** errorMessage);
    void Logout();
    void GetLicenseInfo([out] RpcLicenseInfo* info);
    int ActivateLicense([in, string] wchar_t* activationKey, [out, string] wchar_t** errorMessage);
    void GetAvDatabaseInfo([out] RpcAvDatabaseInfo* info);
    int ScanFile([in, string] wchar_t* path, [out] RpcScanResult* result);
    int ScanDirectory([in, string] wchar_t* path, [out] RpcScanResult* result);
    int ScanFixedDrives([out] RpcScanResult* result);
    int ConfigureScheduledScan(int enabled, int intervalMinutes, int scanFixedDrives, [in, string] wchar_t* path);
    void GetScheduledScanInfo([out] RpcScheduledScanInfo* info);
    int ConfigureDirectoryMonitor(int enabled, [in, string] wchar_t* path);
    void GetDirectoryMonitorInfo([out] RpcDirectoryMonitorInfo* info);
}
